# Alpaca paper-account credentials. Never use live-account keys here.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Keep disabled until `npm run check:alpaca` succeeds.
ALPACA_PAPER_TRADING_ENABLED=false
ALPACA_ALLOWED_SYMBOLS=AAPL,MSFT,NVDA
ALPACA_BUY_NOTIONAL=100
ALPACA_MAX_DAILY_ORDERS=3

# Recommended for protecting Admin trading routes.
ADMIN_TOKEN=

# SMTP credentials for sending real email verification codes at registration.
# Works with any SMTP provider (Gmail app password, Outlook, Brevo, SendGrid SMTP relay, self-hosted, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
